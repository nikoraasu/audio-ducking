<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Follows the system light/dark setting, like the Compose theme; Compose draws everything else. -->
    <style name="Theme.SoundMonitor" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.SoundMonitor.Transparent" parent="Theme.SoundMonitor">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>

